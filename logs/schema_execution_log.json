{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentExecutionLog",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string" },
    "taskId": { "type": "string" },
    "agentRole": { "type": "string" },
    "skillUsed": { "type": "string" },
    "inputs": {
      "type": "object",
      "properties": {
        "targetFiles": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "modifiedFiles": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "NEEDS_REVISION"] }
      }
    },
    "resultDescription": { "type": "string" }
  },
  "required": ["timestamp", "taskId", "agentRole", "inputs", "outputs", "resultDescription"]
}
