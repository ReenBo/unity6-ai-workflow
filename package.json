{
  "name": "unity6-ai-workflow",
  "version": "1.4.1",
  "description": "Production-ready AI workflow ecosystem, subagents, skills, and cross-platform CI/CD automation for Unity 6 applications.",
  "main": "AGENTS.md",
  "scripts": {
    "init-foragents": "powershell -ExecutionPolicy Bypass -File scripts/init-foragents.ps1",
    "init-foragents:sh": "bash scripts/init-foragents.sh",
    "test:unity": "unity test",
    "recompile": "unity recompile",
    "task-cost": "powershell -ExecutionPolicy Bypass -File scripts/get-task-cost.ps1",
    "profile-tokens": "powershell -ExecutionPolicy Bypass -File skills/token-cost-profiler/scripts/analyze-token-bottlenecks.ps1",
    "audit": "python ci/runner.py",
    "audit:ps": "powershell -ExecutionPolicy Bypass -File ci/run-all-checks.ps1",
    "audit:sh": "bash ci/run-all-checks.sh",
    "install-hooks": "powershell -ExecutionPolicy Bypass -File hooks/install-hooks.ps1",
    "install-hooks:sh": "bash hooks/install-hooks.sh"
  },
  "keywords": [
    "unity6",
    "vcontainer",
    "antigravity",
    "ai-agents",
    "subagents",
    "unitask",
    "r3",
    "ci-cd",
    "code-review",
    "pii-scanner"
  ],
  "author": "Reen_Bo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReenBo/unity6-ai-workflow.git"
  }
}
